APP_NAME="Koodify Checkout"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Koodify (merchants only need these two keys) ---
# Browser publishable key (pk_live_… / pk_test_…)
KOODIFY_PUBLIC_KEY=

# Server secret (sk_live_… / sk_test_…)
# Used as X-Api-Key for API calls AND to verify X-Koodify-Signature on webhooks.
KOODIFY_SECRET_KEY=

# KOODIFY_API_BASE=https://api.koodify.ng

# Optional override; defaults to {APP_URL}/webhooks/koodify
# Must be a public HTTPS URL for live webhook delivery (ngrok, etc.)
# KOODIFY_CALLBACK_URL=https://your-tunnel.example/webhooks/koodify

# Amount string passed to inline checkout (demo default)
KOODIFY_DEMO_AMOUNT=50000

# Prefer CDN in production. Local sample ships a vendor copy for offline/dev:
# KOODIFY_INLINE_JS=/vendor/koodify-inline.js
# KOODIFY_INLINE_JS=https://js.koodify.ng/v1/koodify-inline.js
