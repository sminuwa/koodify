APP_NAME="Koodify Merchant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Koodify gateway ---
# Local: http://127.0.0.1:8080   Production: https://api.koodify.ng
KOODIFY_API_BASE=http://127.0.0.1:8080

# Platform admin portal (/admin) — GATEWAY_API_KEY from the Koodify gateway
KOODIFY_GATEWAY_API_KEY=
KOODIFY_ADMIN_EMAIL=admin@koodify.ng
KOODIFY_ADMIN_PASSWORD=Admin123!
KOODIFY_ADMIN_NAME="Koodify Admin"

# Optional fallbacks after merchant onboarding
# KOODIFY_PUBLIC_KEY=pk_live_…
# KOODIFY_SECRET_KEY=sk_live_…

# Optional override; defaults to {APP_URL}/webhooks/koodify
# KOODIFY_CALLBACK_URL=https://your-tunnel.example/webhooks/koodify

KOODIFY_DEMO_AMOUNT=50000

# Prefer CDN in production. Local sample ships a vendor copy for offline/dev:
# KOODIFY_INLINE_JS=/vendor/koodify-inline.js
# KOODIFY_INLINE_JS=https://js.koodify.ng/v1/koodify-inline.js
