GATEWAY_BIND=0.0.0.0:8080
# Secret key — admin / privileged API routes only (do not put in browser)
GATEWAY_API_KEY=change-me-gateway-secret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/koodify
ZAINPAY_BASE_URL=https://sandbox.zainpay.ng
ZAINPAY_API_KEY=your-zainpay-private-key
# Dashboard secret key used for inbound Zainpay-Signature HMAC (required for POST /webhooks/zainpay)
ZAINPAY_WEBHOOK_SECRET=your-zainpay-secret-key
# Public origin of this gateway (no trailing slash). When set, zainbox create/update
# and POST /api/v1/zainboxes/sync-webhook-callbacks write callbackUrl →
# {PUBLIC_BASE_URL}/webhooks/zainpay so Zainpay deposits hit Path 1.
PUBLIC_BASE_URL=https://api.koodify.ng

# Resend — payer receipt emails on successful checkout (optional)
RESEND_API_KEY=re_xxxxxxxxx
# Verified domain sender in production, e.g. Koodify <payments@koodify.ng>
RESEND_FROM=Koodify <onboarding@resend.dev>

# Outbound merchant webhooks (optional). HMAC secret for X-Koodify-Signature on
# POST to checkout callBackUrl / zainbox callback_url. Defaults to GATEWAY_API_KEY.
# MERCHANT_WEBHOOK_SECRET=change-me-merchant-webhook-secret

# Pending-checkout reconciler (Path 2). Polls Zainpay for unpaid inits not already
# covered by an inbound deposit.success webhook, then runs the same enriched side effects.
# RECONCILE_ENABLED=true
# RECONCILE_INTERVAL_SECS=60
# RECONCILE_LOOKBACK_HOURS=48
# RECONCILE_GRACE_SECS=45
# RECONCILE_POLL_COOLDOWN_SECS=120
# RECONCILE_BATCH_SIZE=40

# Adaptive Bank/DVA Routing (optional). Default is gtBank only — keep current behavior.
# Add more keys only after confirming they work with Zainpay temporary/dynamic VA, e.g.:
# VA_BANK_CANDIDATES=gtBank,moniepoint
VA_BANK_CANDIDATES=gtBank
# Sticky preferred-bank TTL in seconds (min 60, default 600)
VA_BANK_STICKY_SECS=600

RUST_LOG=info,koodify=debug

# Optional: port for npm run test:live (static HTML/JS harness)
LIVE_TEST_PORT=5180
