GATEWAY_BIND=0.0.0.0:8080
GATEWAY_API_KEY=change-me-gateway-key
DATABASE_URL=postgres://postgres:postgres@localhost:5432/koodify
ZAINPAY_BASE_URL=https://sandbox.zainpay.ng
ZAINPAY_API_KEY=your-zainpay-private-key
# Dashboard secret key used for inbound Zainpay-Signature HMAC (required for POST /webhooks/zainpay)
ZAINPAY_WEBHOOK_SECRET=your-zainpay-secret-key
RUST_LOG=info,koodify=debug
